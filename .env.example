# MysteryBox Backend Environment Configuration Example
# Copy this file to .env or configure these variables in Render / your hosting environment.

# Server Port
PORT=8080

# Supabase PostgreSQL Connection
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: jdbc:postgresql://<db_host>:<db_port>/<db_name>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password_here

# Hibernate DDL Mode (use update for auto table creation/updates, validate in strict production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Secret Key (Minimum 256 bits / 32 characters)
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32CharactersLong12345!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# In development: http://localhost:5173,http://localhost:3000
# In production: https://mysterybox-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://mysterybox-frontend.onrender.com

# Initial Default Administrator (Created automatically on first startup if not existing)
ADMIN_DEFAULT_EMAIL=admin@mysterybox.com
ADMIN_DEFAULT_PASSWORD=Admin@123
